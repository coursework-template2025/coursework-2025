<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация | Travel Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .auth-container { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #f3f4f6 0%, #e0e7ff 100%); }
        .auth-card { width: 100%; max-width: 400px; border: none; }
    </style>
</head>
<body>

<div class="auth-container">
    <div class="card auth-card shadow-lg p-4">
        <div class="card-body">
            <div class="text-center mb-4">
                <i class="bi bi-globe-americas text-primary" style="font-size: 3rem;"></i>
                <h3 class="fw-bold mt-2">Создать аккаунт</h3>
                <p class="text-muted">Начните историю путешествий</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted">Придумайте логин</label>
                    <input type="text" name="username" class="form-control" required>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted">Придумайте пароль</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Зарегистрироваться</button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <p class="text-muted small mb-0">Уже есть аккаунт?</p>
                <a href="/login" class="text-decoration-none fw-bold">Войти</a>
            </div>
        </div>
    </div>
</div>

</body>
</html>