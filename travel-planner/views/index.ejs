<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Travel Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<h1>✈️ Мои Путешествия</h1>

<div class="form-container">
    <h3>Добавить новую поездку</h3>
    <form action="/add" method="POST">
        <input type="text" name="destination" placeholder="Куда летим? (например, Париж)" required>
        <label>Дата начала:</label>
        <input type="date" name="start_date" required>
        <label>Дата окончания:</label>
        <input type="date" name="end_date" required>
        <input type="number" name="budget" placeholder="Бюджет ($)" required>
        <button type="submit">Добавить</button>
    </form>
</div>

<h3>Запланированные поездки:</h3>
<ul>
    <% if (trips.length === 0) { %>
        <li style="justify-content: center; color: #777;">Пока нет запланированных поездок.</li>
    <% } %>

    <% trips.forEach(function(trip) { %>
        <li>
            <div class="trip-info">
                <div class="trip-destination"><%= trip.destination %></div>
                <div class="trip-date">
                    <%= trip.start_date %> — <%= trip.end_date %>
                    <span style="color: green; margin-left: 10px;">Бюджет: $<%= trip.budget %></span>
                </div>
            </div>
            <form action="/delete/<%= trip.id %>" method="POST" style="margin: 0;">
                <button type="submit" class="delete-btn">Удалить</button>
            </form>
        </li>
    <% }); %>
</ul>

</body>
</html>