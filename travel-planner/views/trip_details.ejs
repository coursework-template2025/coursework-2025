<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Поездка: <%= trip.destination %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg sticky-top mb-4">
    <div class="container">
        <a class="btn btn-light border shadow-sm me-auto" href="/">
            <i class="bi bi-arrow-left me-1"></i> Назад
        </a>
        <span class="navbar-text fw-bold text-dark d-none d-sm-block">
                <%= trip.destination %>
            </span>
    </div>
</nav>

<div class="container pb-5">
    <div class="row h-100">

        <div class="col-lg-5 mb-4">

            <div class="card no-hover shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Детали</h5>
                    <% if (!isCreator) { %> <span class="badge bg-secondary">Только чтение</span> <% } %>
                </div>
                <div class="card-body">
                    <form action="/trip/<%= trip.id %>/edit" method="POST">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Направление</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt"></i></span>
                                <input type="text" name="destination" class="form-control border-start-0 ps-0 fw-bold" value="<%= trip.destination %>" <%= isCreator ? '' : 'disabled' %>>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label text-muted small fw-bold">Начало</label>
                                <input type="date" name="start_date" class="form-control" value="<%= trip.start_date %>" <%= isCreator ? '' : 'disabled' %>>
                            </div>
                            <div class="col">
                                <label class="form-label text-muted small fw-bold">Конец</label>
                                <input type="date" name="end_date" class="form-control" value="<%= trip.end_date %>" <%= isCreator ? '' : 'disabled' %>>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Бюджет ($)</label>
                            <input type="number" name="budget" class="form-control" value="<%= trip.budget %>" <%= isCreator ? '' : 'disabled' %>>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Заметки / Описание</label>
                            <textarea name="description" class="form-control" rows="3" <%= isCreator ? '' : 'disabled' %>><%= trip.description %></textarea>
                        </div>

                        <% if (isCreator) { %>
                            <button type="submit" class="btn btn-success w-100 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Сохранить изменения
                            </button>
                        <% } %>
                    </form>

                    <% if (isCreator) { %>
                        <div class="mt-4 pt-3 border-top">
                            <form action="/delete-trip/<%= trip.id %>" method="POST" onsubmit="return confirm('Вы уверены, что хотите удалить эту поездку? Все чаты и участники будут удалены.');">
                                <button class="btn btn-outline-danger w-100 opacity-75 hover-opacity-100">
                                    <i class="bi bi-trash me-1"></i> Удалить поездку
                                </button>
                            </form>
                        </div>
                    <% } %>

                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold">Команда (<%= participants.length %>)</div>
                <ul class="list-group list-group-flush">
                    <% participants.forEach(p => { %>
                        <li class="list-group-item d-flex align-items-center border-0 px-3 py-2">
                            <div class="bg-light rounded-circle p-2 me-3 text-secondary">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <%= p.username %>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="chat-container shadow-lg h-100" style="min-height: 500px;">
                <div class="d-flex align-items-center border-bottom pb-3 mb-2">
                    <i class="bi bi-chat-dots-fill text-primary me-2 fs-5"></i>
                    <h5 class="mb-0 fw-bold">Обсуждение</h5>
                </div>

                <div class="chat-box" id="chatBox">
                    <% if (notes.length === 0) { %>
                        <div class="text-center mt-5 opacity-50">
                            <i class="bi bi-chat-heart display-1 text-secondary"></i>
                            <p class="mt-3 text-muted">Обсуждайте планы здесь!</p>
                        </div>
                    <% } %>

                    <% notes.forEach(note => { %>
                        <% const isMe = note.username === user.username; %>

                        <div class="message-bubble shadow-sm <%= isMe ? 'msg-own' : 'msg-other' %>">
                            <% if (!isMe) { %>
                                <span class="msg-author"><%= note.username %></span>
                            <% } %>

                            <div class="text-break"><%= note.content %></div>

                            <span class="msg-meta opacity-75">
                                    <%= new Date(note.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                </span>
                        </div>
                    <% }) %>
                </div>

                <div class="mt-3 pt-3 border-top bg-white">
                    <form action="/trip/<%= trip.id %>/note" method="POST" class="d-flex gap-2">
                        <input type="text" name="content" class="form-control border-0 bg-light" placeholder="Напишите сообщение..." required autocomplete="off" style="box-shadow: none;">
                        <button class="btn btn-primary rounded-circle shadow-sm" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-send-fill" style="margin-left: -2px; margin-top: 2px;"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Автопрокрутка чата вниз при загрузке
    const chatBox = document.getElementById('chatBox');
    if(chatBox) {
        chatBox.scrollTop = chatBox.scrollHeight;
    }
</script>
</body>
</html>